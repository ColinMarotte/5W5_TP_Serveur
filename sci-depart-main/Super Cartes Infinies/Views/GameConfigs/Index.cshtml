@model IEnumerable<Super_Cartes_Infinies.Models.GameConfig>

@{
    ViewData["Title"] = "Configuration";
}

<h1>Configuration</h1>

<p>
    <a asp-action="Create">Créer une nouvelle configuration</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NbCardsToDraw)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.QtyManaPerTurn)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NbDecksMax)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NbCardsMaxInDeck)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NbCardsToDraw)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QtyManaPerTurn)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NbDecksMax)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NbCardsMaxInDeck)
                </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Modifier</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Détails</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Supprimer</a>
            </td>
        </tr>
}
    </tbody>
</table>
