@model Super_Cartes_Infinies.Models.GameConfig

@{
    ViewData["Title"] = "Supprimer";
}

<h1>Supprimer</h1>

<h3>Êtes-vous certain de vouloir supprimer cette configuration?</h3>
<div>
    <h4>Configuration</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.NbCardsToDraw)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NbCardsToDraw)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.QtyManaPerTurn)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.QtyManaPerTurn)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NbDecksMax)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NbDecksMax)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.NbCardsMaxInDeck)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NbCardsMaxInDeck)
        </dd>
         <dt class="col-sm-10">
            @Html.DisplayNameFor(model => model.ArgentRecuGagnant)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ArgentRecuGagnant)
        </dd>
        <dt class="col-sm-10">
            @Html.DisplayNameFor(model => model.ArgentRecuPerdant)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ArgentRecuPerdant)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Supprimer" class="btn btn-danger" /> |
        <a asp-action="Index">Retour à la liste</a>
    </form>
</div>
