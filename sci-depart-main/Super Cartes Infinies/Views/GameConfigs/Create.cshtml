@model Super_Cartes_Infinies.Models.GameConfig

@{
    ViewData["Title"] = "Créer";
}

<h1>Créer une configuration</h1>

<h4>Configuration</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="NbCardsToDraw" class="control-label"></label>
                <input asp-for="NbCardsToDraw" class="form-control" />
                <span asp-validation-for="NbCardsToDraw" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="QtyManaPerTurn" class="control-label"></label>
                <input asp-for="QtyManaPerTurn" class="form-control" />
                <span asp-validation-for="QtyManaPerTurn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NbDecksMax" class="control-label"></label>
                <input asp-for="NbDecksMax" class="form-control" />
                <span asp-validation-for="NbDecksMax" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NbCardsMaxInDeck" class="control-label"></label>
                <input asp-for="NbCardsMaxInDeck" class="form-control" />
                <span asp-validation-for="NbCardsMaxInDeck" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Créer" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Retour à la liste</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
