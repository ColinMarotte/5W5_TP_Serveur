@model Super_Cartes_Infinies.Models.Card

@{
	ViewData["Title"] = "Détails";
}

<h1>Détails</h1>

<div>
    <h4>Carte Modèle</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Attack)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Attack)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Health)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Health)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Cost)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cost)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Rarity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Rarity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ImageUrl)
        </dt>
        <dd class = "col-sm-10">
            <img src="@Html.DisplayFor(model => model.ImageUrl)" height="100" alt="Image de la carte" />


		</dd>
		<dt class="col-sm-2">
			@Html.DisplayNameFor(model => model.CardPowers)
		</dt>
		<dd class="col-sm-10">
			@if (Model.CardPowers != null)
			{
				@foreach (var cp in Model.CardPowers)
				{
					<div>@cp.Power.Icone @cp.Power.Name @cp.Value</div>
				}

			}
		</dd>
	</dl>
</div>
<div>
	<a asp-action="Edit" asp-route-id="@Model?.Id">Modifier</a> |
	<a asp-action="Index">Retour à la liste</a>
</div>
