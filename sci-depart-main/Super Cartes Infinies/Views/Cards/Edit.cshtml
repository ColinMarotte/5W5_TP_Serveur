@model Super_Cartes_Infinies.Models.Card

@{
    ViewData["Title"] = "Modifier";
    var allPowers = ViewBag.AllPowers as List<Super_Cartes_Infinies.Models.Power>;
}

<h1>Modifier</h1>

<h4>Cartes Modèle</h4>
<hr />
<div class="row">
    <div class="column">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Attack" class="control-label"></label>
                <input asp-for="Attack" class="form-control" />
                <span asp-validation-for="Attack" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Health" class="control-label"></label>
                <input asp-for="Health" class="form-control" />
                <span asp-validation-for="Health" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cost" class="control-label"></label>
                <input asp-for="Cost" class="form-control" />
                <span asp-validation-for="Cost" class="text-danger"></span>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Rarity)
                @Html.DropDownListFor(
                         model => model.Rarity,
                         new SelectList(Enum.GetValues(typeof(Rarity))),
                         "Select Rarity",
                         new { @class = "form-control" }
                         )
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl" class="control-label">Url de l'image</label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Accepter" class="btn btn-primary" style="margin-top: 12px" />
            </div>
            <div>
                <a asp-action="Index">Retour à la liste</a>
            </div>
        </form>
    </div>

    <div class="column">
        <ul>
            @foreach (var cardpower in Model.CardPowers)
            {

                <li>
                    <p>
                        @cardpower.Power.Icone @cardpower.Power.Name @cardpower.Value
                        <input type="hidden" name="newPowerId" value="@cardpower.PowerId" />
                    </p>
                    <form asp-action="DeletePower" method="post">
                        <input type="hidden" name="cardId" value="@Model.Id" />
                        <input type="hidden" name="powerId" value="@cardpower.PowerId" />
                        <button type="submit" class="btn btn-danger">X</button>
                    </form>
                </li>

            }
        </ul>

        <form asp-action="AddPower" method="post" class="row">
            <input type="hidden" name="_id" value="@Model.Id" asp-for="Id" />
            <div class="col-md-6">
                <div class="form-group">
                    @if (Model.CardPowers.Count < 4)
                    {
                        <select name="newPowerId" class="form-control">
                            @foreach (var power in allPowers)
                            {
                                var dejaUnPouvoir = Model.CardPowers.Any(cp => cp.PowerId == power.Id);
                                if (!dejaUnPouvoir)
                                {
                                    <option value="@power.Id"> @power.Icone @power.Name</option>
                                }
                            }
                        </select>

                        <br />
                        <input type="number" name="newPowerValue" placeholder="Valeur" value="1" min="1" max="@int.MaxValue" class="form-control" /> <br />
                        <button type="submit" class="btn btn-primary">+</button>
                    }

                </div>
            </div>
        </form>
    </div>
</div>


<style>
    .column {
        float: left;
        width: 50%;
    }

    .row:after {
        content: "";
        display: table;
        clear: both;
    }
</style>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
