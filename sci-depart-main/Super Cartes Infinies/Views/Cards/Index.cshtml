@model IEnumerable<Super_Cartes_Infinies.Models.Card>

@{
	var cardPowers = ViewBag.CardPowers as Dictionary<int, List<Super_Cartes_Infinies.Models.Power>>;
}

<h1>Cartes</h1>

<p>
	<a asp-action="Create">Créer</a>
</p>
<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.Name)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Attack)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Health)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Cost)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.CardPowers)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.ImageUrl)
			</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.Name)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Attack)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Health)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Cost)
				</td>
				<td>
					@if (cardPowers != null && cardPowers.ContainsKey(item.Id))
					{
						<ul>
							@foreach (var power in cardPowers[item.Id])
							{
								<li>
									<i class="@power.Icone"></i> <span>@power.Name @* @power.value *@</span>
								</li>
							}
						</ul>
					}
				</td>
				<td>
					<img src="@Html.DisplayFor(modelItem => item.ImageUrl)" height="100" alt="Image de la carte" />

				</td>
				<td>
					<a asp-action="Edit" asp-route-id="@item.Id">Modifier</a> |
					<a asp-action="Details" asp-route-id="@item.Id">Détails</a> |
					<a asp-action="Delete" asp-route-id="@item.Id">Supprimer</a>|
					<a asp-controller="StartingCards" asp-action="AddStartingCard" asp-route-id="@item.Id">Ajouter aux cartes de départ</a>
				</td>
			</tr>
		}
	</tbody>
</table>
