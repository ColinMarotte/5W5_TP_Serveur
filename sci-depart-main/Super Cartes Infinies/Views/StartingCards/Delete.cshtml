@model Super_Cartes_Infinies.Models.StartingCard

@{
    ViewData["Title"] = "Supprimer";
}

<h1>Supprimer</h1>

<h3>Êtes-vous certain de vouloir supprimer ce modèle de carte?</h3>
<div>
    <h4>Carte Modèle</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Card.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Card.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Card.Attack)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Card.Attack)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Card.Health)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Card.Health)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Card.Cost)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Card.Cost)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Card.ImageUrl)
        </dt>
        <dd class="col-sm-10">
            <img src="@Html.DisplayFor(model => model.Card.ImageUrl)" height="100" alt="Image de la carte" />
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Supprimer" class="btn btn-danger" /> |
        <a asp-action="Index">Retour à la liste</a>
    </form>
</div>
